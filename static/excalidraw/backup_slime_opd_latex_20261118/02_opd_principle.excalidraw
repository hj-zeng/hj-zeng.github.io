    {
      "type": "text",
      "id": "opd_kd_formula_text",
      "x": 78, "y": 370,
      "width": 604, "height": 28,
      "text": "L_SD(θ) = E_{(x,y)∼D}[ D_KL(P_T(·|y<t,x) ‖ P_S^θ(·|y<t,x)) ]",
