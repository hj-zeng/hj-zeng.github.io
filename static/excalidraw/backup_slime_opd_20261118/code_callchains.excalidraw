    {
      "type": "rectangle",
      "id": "cc_code",
      "x": 780, "y": 394,
      "width": 640, "height": 120,
      "strokeColor": "#1e293b",
      "backgroundColor": "#1e293b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 600091,
      "version": 1,
      "versionNonce": 600092,
      "isDeleted": false,
