      "link": null,
      "locked": false,
      "roundness": {"type": 3}
    },
    {
      "type": "text",
      "id": "cc_code_t",
      "x": 796, "y": 404,
      "width": 608, "height": 100,
      "text": "for i, adv in enumerate(advantages):\n    reverse_kl = student_log_probs[i] - teacher_log_probs[i]\n    advantages[i] = adv - args.opd_kl_coef * reverse_kl\n    reverse_kls.append(reverse_kl)\nrollout_data[\"opd_reverse_kl\"] = reverse_kls",
      "originalText": "for i, adv in enumerate(advantages):\n    reverse_kl = student_log_probs[i] - teacher_log_probs[i]\n    advantages[i] = adv - args.opd_kl_coef * reverse_kl\n    reverse_kls.append(reverse_kl)\nrollout_data[\"opd_reverse_kl\"] = reverse_kls",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 600093,
      "version": 1,
      "versionNonce": 600094,
      "isDeleted": false,
